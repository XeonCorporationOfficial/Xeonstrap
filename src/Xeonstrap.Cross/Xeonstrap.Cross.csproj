	</Target>

	<Target Name="PrepareLinuxReadyToRunInputs" BeforeTargets="_PrepareForReadyToRunCompilation" DependsOnTargets="_ProGpuWpfSdkPublishManagedTransportRuntimeAssets" Condition="($(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))) And '$(PublishReadyToRun)' == 'true'">
		<ItemGroup>
			<_XeonstrapReadyToRunDuplicate Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'System.Private.Windows.Core.dll' And $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('librewpf.transport'))" />
			<ResolvedFileToPublish Remove="@(_XeonstrapReadyToRunDuplicate)" />
			<ResolvedFileToPublish Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' And '%(ResolvedFileToPublish.PostprocessAssembly)' != 'true' And '%(ResolvedFileToPublish.RelativePath)' == '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' And !$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources'))">
				<PostprocessAssembly>true</PostprocessAssembly>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

	<Target Name="ReplaceLinuxProGpuWpfBundle" AfterTargets="_ComputeFilesToBundle" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(PublishSingleFile)' == 'true' And '$(PublishReadyToRun)' != 'true'">
