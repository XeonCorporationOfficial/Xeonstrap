<Project Sdk="LibreWPF.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<StartupObject>Xeonstrap.Program</StartupObject>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<PublishTrimmed>false</PublishTrimmed>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<ProGpuWpfSystemFormatsNrbfVersion>10.0.13</ProGpuWpfSystemFormatsNrbfVersion>
		<BaseOutputPath Condition="'$(RuntimeIdentifier)' != '' And '$(XeonstrapLinuxPackagingRoot)' == ''">bin-$(RuntimeIdentifier)\</BaseOutputPath>
		<AssemblyName>Xeonstrap</AssemblyName>
		<RootNamespace>Xeonstrap</RootNamespace>
		<EnableDefaultItems>false</EnableDefaultItems>
		<DefineConstants>$(DefineConstants);CROSSPLAT</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProGpuWpfUsePortableFrameworkReferences>true</ProGpuWpfUsePortableFrameworkReferences>
		<ProGpuWpfSystemSecurityCryptographyXmlVersion>10.0.13</ProGpuWpfSystemSecurityCryptographyXmlVersion>
		<ProGpuWpfUsePortableWinFormsCompat>false</ProGpuWpfUsePortableWinFormsCompat>
		<ProGpuWpfUseLibreWinForms>false</ProGpuWpfUseLibreWinForms>
		<NoWarn>$(NoWarn);CS8305</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
	</PropertyGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
		<TieredPGO>false</TieredPGO>
		<LinuxProGpuWpfAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\ProGPU.Wpf.dll</LinuxProGpuWpfAssembly>
		<LinuxPresentationCoreAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationCore.dll</LinuxPresentationCoreAssembly>
		<LinuxPresentationFrameworkAssembly>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\PresentationFramework.dll</LinuxPresentationFrameworkAssembly>
		<LinuxWgpuLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native.so</LinuxWgpuLibrary>
		<LinuxGlfwLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libglfw.so.3</LinuxGlfwLibrary>
	</PropertyGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And Exists('$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so')">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\$(RuntimeIdentifier)\libwgpu_native_gl.so">
			<Link>libwgpu_native_gl.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<LinuxEditorCompatLibrary>$(MSBuildProjectDirectory)\..\..\external\LibreWPF\libxeonstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">$(MSBuildProjectDirectory)\..\..\external\LibreWPF\linux-arm64\libxeonstrapeditorcompat.so</LinuxEditorCompatLibrary>
		<LinuxEditorCompatLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(BaseIntermediateOutputPath)editorcompat/$(RuntimeIdentifier)/libxeonstrapeditorcompat.so</LinuxEditorCompatLibrary>
	</PropertyGroup>

	<Target Name="BuildLinuxEditorCompat" BeforeTargets="PrepareForBuild" Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Linux'))" Inputs="$(MSBuildProjectDirectory)/../../build/Packaging/Linux/editor-compat.c;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh" Outputs="$(LinuxEditorCompatLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/Linux/build-native-compat.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(LinuxEditorCompatLibrary)&quot;" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))">
		<XeonImageFileName Condition="$(RuntimeIdentifier.StartsWith('linux'))">libxeonimage.so</XeonImageFileName>
		<XeonImageFileName Condition="$(RuntimeIdentifier.StartsWith('osx'))">libxeonimage.dylib</XeonImageFileName>
		<XeonImageLibrary>$(BaseIntermediateOutputPath)xeonimage/$(RuntimeIdentifier)/$(XeonImageFileName)</XeonImageLibrary>
	</PropertyGroup>

	<Target Name="BuildXeonImage" BeforeTargets="AssignTargetPaths" Condition="'$(XeonImageLibrary)' != '' And '$(DesignTimeBuild)' != 'true' And !$([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/xeonimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/xeonimage/Cargo.lock;@(XeonImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-xeonimage.sh" Outputs="$(XeonImageLibrary)">
		<Exec Command="bash &quot;$(MSBuildProjectDirectory)/../../build/Packaging/build-xeonimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(XeonImageLibrary)&quot; &quot;$(BaseIntermediateOutputPath)xeonimage/target&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Windows'))">
		<XeonstrapWslDistro Condition="'$(XeonstrapWslDistro)' == ''">Ubuntu</XeonstrapWslDistro>
		<_XeonImageRootWin>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_XeonImageRootWin>
		<_XeonImageLibraryWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(XeonImageLibrary)'))))</_XeonImageLibraryWin>
		<_XeonImageTargetWin>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)xeonimage/target'))))</_XeonImageTargetWin>
		<_XeonImageRootWsl>/mnt/$(_XeonImageRootWin.Substring(0, 1).ToLowerInvariant())$(_XeonImageRootWin.Substring(2).Replace('%5C', '/'))</_XeonImageRootWsl>
		<_XeonImageLibraryWsl>/mnt/$(_XeonImageLibraryWin.Substring(0, 1).ToLowerInvariant())$(_XeonImageLibraryWin.Substring(2).Replace('%5C', '/'))</_XeonImageLibraryWsl>
		<_XeonImageTargetWsl>/mnt/$(_XeonImageTargetWin.Substring(0, 1).ToLowerInvariant())$(_XeonImageTargetWin.Substring(2).Replace('%5C', '/'))</_XeonImageTargetWsl>
	</PropertyGroup>

	<Target Name="BuildXeonImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And $([MSBuild]::IsOSPlatform('Windows'))" Inputs="$(MSBuildProjectDirectory)/../../native/xeonimage/Cargo.toml;$(MSBuildProjectDirectory)/../../native/xeonimage/Cargo.lock;@(XeonImageSources);$(MSBuildProjectDirectory)/../../build/Packaging/build-xeonimage.sh" Outputs="$(XeonImageLibrary)">
		<Exec Command="wsl.exe -d $(XeonstrapWslDistro) -e bash &quot;$(_XeonImageRootWsl)build/Packaging/build-xeonimage.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_XeonImageLibraryWsl)&quot; &quot;$(_XeonImageTargetWsl)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<Target Name="RequireLinuxXeonImage" DependsOnTargets="BuildXeonImage;BuildXeonImageThroughWsl" BeforeTargets="AssignTargetPaths" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '$(DesignTimeBuild)' != 'true' And '$(XeonstrapAllowMissingXeonImage)' != 'true'">
		<Error Condition="!Exists('$(XeonImageLibrary)')" Text="libxeonimage.so was not built for $(RuntimeIdentifier). Linux builds cannot show any image without it. Install Rust (and WSL with Rust when building on Windows), or set XeonstrapAllowMissingXeonImage=true to build anyway." />
	</Target>

	<ItemGroup>
		<XeonImageSources Include="$(MSBuildProjectDirectory)/../../native/xeonimage/src/**/*.rs" />
	</ItemGroup>

	<Target Name="IncludeXeonImage" DependsOnTargets="BuildXeonImage;BuildXeonImageThroughWsl;RequireLinuxXeonImage" BeforeTargets="AssignTargetPaths" Condition="'$(XeonImageLibrary)' != ''">
		<ItemGroup>
			<None Condition="Exists('$(XeonImageLibrary)')" Include="$(XeonImageLibrary)" Link="$(XeonImageFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\GLFW-LICENSE.txt" Condition="Exists('$(LinuxGlfwLibrary)')">
			<Link>GLFW-LICENSE.txt</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="$(LinuxEditorCompatLibrary)">
			<Link>libxeonstrapeditorcompat.so</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\osx\libxeonstrapeditorcompat.dylib">
			<Link>libxeonstrapeditorcompat.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))">
		<None Include="$(MSBuildProjectDirectory)\..\..\external\LibreWPF\System.Windows.Forms.dll">
			<Link>System.Windows.Forms.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<Target Name="BundleManagedTransportAssets" BeforeTargets="_ComputeFilesToBundle" DependsOnTargets="_ProGpuWpfSdkPublishManagedTransportRuntimeAssets" Condition="'$(PublishSingleFile)' == 'true'" />

	<ItemGroup>
		<TrimmerRootAssembly Include="Xeonstrap" />
		<TrimmerRootAssembly Include="PresentationFramework" />
		<TrimmerRootAssembly Include="PresentationCore" />
		<TrimmerRootAssembly Include="PresentationUI" />
		<TrimmerRootAssembly Include="WindowsBase" />
		<TrimmerRootAssembly Include="System.Xaml" />
		<TrimmerRootAssembly Include="UIAutomationProvider" />
		<TrimmerRootAssembly Include="UIAutomationTypes" />
		<TrimmerRootAssembly Include="Wpf.Ui" />
		<TrimmerRootAssembly Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="*.cs" />
		<Compile Visible="false" Include="..\Xeonstrap.App\**\*.cs" Exclude="..\Xeonstrap.App\obj\**;..\Xeonstrap.App\obj-*\**;..\Xeonstrap.App\bin\**;..\Xeonstrap.App\bin-*\**;..\Xeonstrap.App\UI\Elements\RobloxWeb\**;..\Xeonstrap.App\UI\Elements\Controls\InlineVideoPlayer.xaml.cs;..\Xeonstrap.App\UI\Elements\ContextMenu\Web\**;..\Xeonstrap.App\UI\Elements\Bootstrapper\ProgressDialog*.cs;..\Xeonstrap.App\UI\Elements\Bootstrapper\LegacyDialog*.cs;..\Xeonstrap.App\UI\Elements\Bootstrapper\VistaDialog*.cs;..\Xeonstrap.App\UI\Elements\Bootstrapper\Base\WinFormsDialogBase.cs;..\Xeonstrap.App\Integrations\RiShade\RiShadeWgc.cs;..\Xeonstrap.App\Integrations\RiShade\RiShadeWinRtStubs*.cs" />
		<Page Visible="false" Include="..\Xeonstrap.App\**\*.xaml" Exclude="..\Xeonstrap.App\obj\**;..\Xeonstrap.App\obj-*\**;..\Xeonstrap.App\bin\**;..\Xeonstrap.App\bin-*\**;..\Xeonstrap.App\App.xaml;..\Xeonstrap.App\UI\Elements\RobloxWeb\**;..\Xeonstrap.App\UI\Elements\Controls\InlineVideoPlayer.xaml;..\Xeonstrap.App\UI\Elements\ContextMenu\Web\**;..\Xeonstrap.App\UI\Elements\About\MainWindow.xaml;..\Xeonstrap.App\UI\Elements\Installer\MainWindow.xaml" />
		<Page Remove="..\Xeonstrap.App\UI\Elements\Installer\Pages\ChannelPage.xaml" />
		<Page Include="Xaml\AboutMainWindow.xaml" />
		<Page Include="Xaml\InstallerMainWindow.xaml" Condition="!$(RuntimeIdentifier.StartsWith('linux')) And !$(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerMainWindow.Linux.xaml" Condition="$(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerChannelPage.xaml" Condition="!$(RuntimeIdentifier.StartsWith('linux')) And !$(RuntimeIdentifier.StartsWith('osx'))" />
		<Page Include="Xaml\InstallerChannelPage.Linux.xaml" Condition="$(RuntimeIdentifier.StartsWith('linux'))" />
		<Page Include="Xaml\InstallerChannelPage.MacOS.xaml" Condition="$(RuntimeIdentifier.StartsWith('osx'))" />
		<ApplicationDefinition Visible="false" Include="..\Xeonstrap.App\App.xaml">
			<Link>App.xaml</Link>
		</ApplicationDefinition>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Visible="false" Include="..\Xeonstrap.App\Resources\**\*" Exclude="..\Xeonstrap.App\Resources\**\*.cs;..\Xeonstrap.App\Resources\**\*.ico;..\Xeonstrap.App\Resources\**\*.jpg;..\Xeonstrap.App\Resources\**\*.png;..\Xeonstrap.App\Resources\Fonts\Montserrat-*.ttf;..\Xeonstrap.App\Resources\Fonts\NotoSansThai-*.ttf;..\Xeonstrap.App\Resources\Fonts\Rubik-*.ttf">
			<Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Xeonstrap.App\Resources\Mods\Cursor\**\*.png">
			<Link>Resources\Mods\Cursor\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Xeonstrap.App\Properties\*.resx">
			<Link>Properties\%(Filename)%(Extension)</Link>
		</EmbeddedResource>
		<EmbeddedResource Visible="false" Include="..\Xeonstrap.App\UI\Style\*.xshd">
			<Link>UI\Style\%(Filename)%(Extension)</Link>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Resource Visible="false" Include="..\Xeonstrap.App\Xeonstrap.ico">
			<Link>Xeonstrap.ico</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Xeonstrap.png">
			<Link>Xeonstrap.png</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\RobloxVngIcon.png">
			<Link>Resources\RobloxVngIcon.png</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\Checkmark.ico;..\Xeonstrap.App\Resources\CrossMark.ico;..\Xeonstrap.App\Resources\Icon2008.ico;..\Xeonstrap.App\Resources\Icon2011.ico;..\Xeonstrap.App\Resources\Icon2017.ico;..\Xeonstrap.App\Resources\Icon2019.ico;..\Xeonstrap.App\Resources\Icon2022.ico;..\Xeonstrap.App\Resources\IconEarly2015.ico;..\Xeonstrap.App\Resources\IconLate2015.ico;..\Xeonstrap.App\Resources\IconXeonstrap.ico;..\Xeonstrap.App\Resources\Erik.png;..\Xeonstrap.App\Resources\RobloxFace.png;..\Xeonstrap.App\Resources\RobloxPlayerIcon.png;..\Xeonstrap.App\Resources\RobloxStudioIcon.png;..\Xeonstrap.App\Resources\SoberIcon.png;..\Xeonstrap.App\Resources\VinegarIcon.png">
			<Link>Resources\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\BootstrapperStyles\ByfronDialog\ByfronLogoDark.jpg;..\Xeonstrap.App\Resources\BootstrapperStyles\ByfronDialog\ByfronLogoLight.jpg;..\Xeonstrap.App\Resources\BootstrapperStyles\ByfronDialog\Matt.png">
			<Link>Resources\BootstrapperStyles\ByfronDialog\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\CommunityMods\*.png">
			<Link>Resources\CommunityMods\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\Fonts\NotoSansThai-VariableFont_wdth,wght.ttf;..\Xeonstrap.App\Resources\Fonts\Rubik-VariableFont_wght.ttf">
			<Link>Resources\Fonts\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\..\external\wpfui\src\Wpf.Ui\Fonts\Source\FluentSystemIcons-Regular.ttf">
			<Link>Resources\Fonts\SymbolIcons\FluentSystemIcons-Regular.ttf</Link>
		</Resource>
		<Resource Visible="false" Include="..\..\external\wpfui\src\Wpf.Ui\Fonts\Source\FluentSystemIcons-Filled.ttf" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
			<Link>Resources\Fonts\SymbolIcons\FluentSystemIcons-Filled.ttf</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\MessageBox\Error.png;..\Xeonstrap.App\Resources\MessageBox\Information.png;..\Xeonstrap.App\Resources\MessageBox\Question.png;..\Xeonstrap.App\Resources\MessageBox\Warning.png">
			<Link>Resources\MessageBox\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\Flags\*.png">
			<Link>Resources\Flags\%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\Mods\Cursor\**\*.png">
			<Link>Resources\Mods\Cursor\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Resource>
		<Resource Visible="false" Include="..\Xeonstrap.App\Resources\AppImages\*.png">
			<Link>Resources\AppImages\%(Filename)%(Extension)</Link>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'" />
		<RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="true" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Markdig" Version="1.4.0" />
		<PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.360">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NAudio" Version="3.1.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
		<PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
		<PackageReference Include="securifybv.ShellLink" Version="0.1.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.12" />
		<PackageReference Include="System.Management" Version="10.0.13" />
		<PackageReference Include="System.Resources.Extensions" Version="10.0.13" />
		<PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
		<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
		<PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
		<PackageReference Include="Vortice.DXGI" Version="3.8.3" />
		<PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
		<PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
		<PackageReference Include="Openize.Drako" Version="26.2.0" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
		<PackageReference Include="Tmds.DBus" Version="0.95.1" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Visible="false" Include="..\Xeonstrap.App\NativeMethods.txt" Link="NativeMethods.txt" />
		<ProjectReference Include="..\Xeonstrap.Core\Xeonstrap.Core.csproj" />
		<ProjectReference Include="..\Xeonstrap.Platform.Abstractions\Xeonstrap.Platform.Abstractions.csproj" />
		<ProjectReference Include="..\Xeonstrap.Platform.Linux\Xeonstrap.Platform.Linux.csproj" />
		<ProjectReference Include="..\Xeonstrap.Platform.MacOS\Xeonstrap.Platform.MacOS.csproj" />
		<ProjectReference Include="..\..\external\wpfui\src\Wpf.Ui\Wpf.Ui.Cross.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="Xeonstrap.Models.Attributes.BuildMetadataAttribute">
			<_Parameter1>1970-01-01T00:00:00Z</_Parameter1>
			<_Parameter2></_Parameter2>
			<_Parameter3>$(CommitHash)</_Parameter3>
			<_Parameter4>$(CommitRef)</_Parameter4>
		</AssemblyAttribute>
	</ItemGroup>

	<Target Name="StripWindowsDesktopFrameworkRefs" AfterTargets="ResolvePackageAssets" BeforeTargets="AddTransitiveFrameworkReferences">
		<ItemGroup>
			<TransitiveFrameworkReference Remove="@(TransitiveFrameworkReference)" Condition="$([System.String]::Copy('%(TransitiveFrameworkReference.Identity)').Contains('WindowsDesktop'))" />
		</ItemGroup>
	</Target>

	<Target Name="StripWindowsDesktopDirectRefs" BeforeTargets="ProcessFrameworkReferences">
		<ItemGroup>
			<FrameworkReference Remove="@(FrameworkReference)" Condition="$([System.String]::Copy('%(FrameworkReference.Identity)').Contains('WindowsDesktop'))" />
		</ItemGroup>
	</Target>

	<Target Name="StripPublishExtras" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.xml' Or '%(ResolvedFileToPublish.Extension)' == '.pdb'" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('libmscordaccore')) Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('libmscordbi')) Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('mscordaccore')) Or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('mscordbi'))" />
		</ItemGroup>
	</Target>

  <Target Name="RemoveDuplicatePortableCoreAssemblies" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XeonstrapDuplicatePublishFile Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'System.Private.Windows.Core.dll' And $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('librewpf.transport'))" />
      <ResolvedFileToPublish Remove="@(_XeonstrapDuplicatePublishFile)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveDuplicateBundleAssemblies" AfterTargets="_ComputeFilesToBundle" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_XeonstrapDuplicateBundleFile Include="@(_FilesToBundle)" Condition="'%(_FilesToBundle.Filename)%(_FilesToBundle.Extension)' == 'System.Private.Windows.Core.dll' And $([System.String]::Copy('%(_FilesToBundle.Identity)').Contains('librewpf.transport'))" />
      <_FilesToBundle Remove="@(_XeonstrapDuplicateBundleFile)" />
    </ItemGroup>
  </Target>

	<Target Name="ReplaceLinuxProGpuWpfOutput" AfterTargets="ResolveReferences" BeforeTargets="CopyFilesToOutputDirectory" Condition="($(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx')))">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'ProGPU.Wpf.dll'" />
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'PresentationCore.dll'" />
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'PresentationFramework.dll'" />
			<ReferenceCopyLocalPaths Include="$(LinuxProGpuWpfAssembly)" />
			<ReferenceCopyLocalPaths Include="$(LinuxPresentationCoreAssembly)" />
			<ReferenceCopyLocalPaths Include="$(LinuxPresentationFrameworkAssembly)" />
		</ItemGroup>
	</Target>

	<Target Name="CopyLinuxProGpuWpfOutput" AfterTargets="_ProGpuWpfSdkCopyPackageRuntimeAssets" Condition="($(RuntimeIdentifier.StartsWith('linux')) Or $(RuntimeIdentifier.StartsWith('osx')))">
		<Copy SourceFiles="$(LinuxProGpuWpfAssembly);$(LinuxPresentationCoreAssembly);$(LinuxPresentationFrameworkAssembly)" DestinationFiles="$(TargetDir)ProGPU.Wpf.dll;$(TargetDir)PresentationCore.dll;$(TargetDir)PresentationFramework.dll" SkipUnchangedFiles="false" />
