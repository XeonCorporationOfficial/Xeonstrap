<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!--
    Xeonstrap Aurora component layer.

    These are keyed styles only. Nothing here is implicit, so the legacy windows keep
    their existing look and the new shell opts in resource by resource. Every colour
    comes from the shared Xeon Aurora tokens in UI/Style/RinUI.xaml, which means the
    whole layer follows the selected theme (Dark, Light, Aurora, custom).
  -->

  <sys:Double x:Key="AuroraDisplaySize">30</sys:Double>
  <sys:Double x:Key="AuroraTitleSize">21</sys:Double>
  <sys:Double x:Key="AuroraSectionSize">11.5</sys:Double>
  <sys:Double x:Key="AuroraBodySize">13.5</sys:Double>
  <sys:Double x:Key="AuroraCaptionSize">11.5</sys:Double>
  <sys:Double x:Key="AuroraNavItemHeight">34</sys:Double>
  <CornerRadius x:Key="AuroraCardRadius">16</CornerRadius>
  <CornerRadius x:Key="AuroraControlRadius">10</CornerRadius>
  <CornerRadius x:Key="AuroraPillRadius">999</CornerRadius>
  <Thickness x:Key="AuroraCardPadding">20</Thickness>
  <Thickness x:Key="AuroraPagePadding">28,22,28,28</Thickness>

  <!-- Derived brushes, so this layer only depends on the shared Aurora colour tokens. -->
  <SolidColorBrush x:Key="AuroraAccentBrush" Color="{DynamicResource XeonAuroraAccent}" />
  <SolidColorBrush x:Key="AuroraAccentHoverBrush" Color="{DynamicResource XeonAuroraAccentHover}" />
  <SolidColorBrush x:Key="AuroraStrokeHoverBrush" Color="{DynamicResource XeonAuroraCardBorderHover}" />
  <SolidColorBrush x:Key="AuroraInkHighBrush" Color="{DynamicResource XeonAuroraInkHigh}" />

  <!-- ============================ Surfaces ============================ -->

  <Style x:Key="AuroraCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource AuroraCardRadius}" />
    <Setter Property="Padding" Value="{StaticResource AuroraCardPadding}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraCardInteractiveStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource AuroraCardStyle}">
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AuroraStrokeHoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="AuroraHeroStyle" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="{StaticResource AuroraCardRadius}" />
    <Setter Property="Padding" Value="26" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource AuroraStrokeHoverBrush}" />
    <Setter Property="Background" Value="{DynamicResource XeonAuroraAccentSoftBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraDividerStyle" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="Margin" Value="0,10" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraRailStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraChromeBarStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ============================ Typography ============================ -->

  <Style x:Key="AuroraDisplayStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraDisplaySize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="AuroraPageTitleStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraTitleSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="AuroraPageSubtitleStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraBodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="AuroraSectionTitleStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraSectionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="Margin" Value="2,0,0,8" />
  </Style>

  <Style x:Key="AuroraBodyStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraBodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="AuroraMutedStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraCaptionSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="AuroraGroupHeaderStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource AuroraSectionSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="Margin" Value="12,16,0,6" />
  </Style>

  <!-- ============================== Buttons ============================== -->

  <Style x:Key="AuroraPrimaryButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  CornerRadius="{StaticResource AuroraControlRadius}"
                  Background="{DynamicResource XeonAuroraAccentBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource XeonAuroraCardBorderHoverBrush}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Presenter"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
              <Setter TargetName="Surface" Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AuroraSecondaryButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  CornerRadius="{StaticResource AuroraControlRadius}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              <Setter TargetName="Surface" Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AuroraCardButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource AuroraCardRadius}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AuroraStrokeHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AuroraGhostButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  CornerRadius="8"
                  Background="Transparent"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AuroraIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AuroraGhostButtonStyle}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ============================== Pieces ============================== -->

  <Style x:Key="AuroraChipStyle" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="{StaticResource AuroraPillRadius}" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraChipTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="AuroraSearchSurfaceStyle" TargetType="{x:Type Border}">
    <Setter Property="CornerRadius" Value="{StaticResource AuroraControlRadius}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="AuroraInlineTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <ScrollViewer x:Name="PART_ContentHost"
                        Margin="0"
                        VerticalAlignment="Center"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- =============================== Rail nav =============================== -->

  <Style x:Key="AuroraNavListStyle" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <ScrollViewer Padding="{TemplateBinding Padding}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AuroraNavItemStyle" TargetType="{x:Type ListBoxItem}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border x:Name="Surface"
                  Background="Transparent"
                  CornerRadius="10"
                  Padding="8,7"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Marker"
                      Width="3"
                      Height="15"
                      CornerRadius="2"
                      Background="Transparent"
                      VerticalAlignment="Center" />
              <ui:SymbolIcon x:Name="Glyph"
                             Grid.Column="1"
                             Margin="9,0,0,0"
                             FontSize="15"
                             Symbol="{Binding Icon}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock x:Name="Label"
                         Grid.Column="2"
                         Margin="10,0,0,0"
                         FontSize="12.5"
                         Text="{Binding Title}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Border x:Name="Badge"
                      Grid.Column="3"
                      CornerRadius="999"
                      Padding="7,1"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                      VerticalAlignment="Center"
                      Visibility="{Binding BadgeVisibility}">
                <TextBlock FontSize="10"
                           Text="{Binding Badge}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource XeonAuroraAccentSoftBrush}" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource XeonAuroraAccentBrush}" />
              <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AuroraAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
