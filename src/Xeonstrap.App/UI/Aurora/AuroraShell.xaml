<base:WpfUiWindow
    x:Class="Xeonstrap.UI.Aurora.AuroraShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Xeonstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Xeonstrap"
    Width="1140"
    Height="740"
    MinWidth="940"
    MinHeight="580"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    AllowsTransparency="False"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    Loaded="Shell_Loaded"
    Closed="Shell_Closed"
    PreviewKeyDown="Shell_PreviewKeyDown">

    <Grid x:Name="RootGrid" Background="{DynamicResource ApplicationBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Aurora glow behind everything, non-interactive. -->
        <Border Grid.RowSpan="2" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="#3D9B82FF" />
                    <GradientStop Offset="0.42" Color="#1A1B1630" />
                    <GradientStop Offset="1.0" Color="#2E3B82F6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ======================= Caption bar ======================= -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="ShellTitleBar"
                     Padding="10,0,0,0"
                     ForceShutdown="False"
                     MinimizeToTray="False"
                     UseSnapLayout="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                    <Border Width="19" Height="19" CornerRadius="6" Background="{DynamicResource XeonAuroraAccentBrush}" />
                    <TextBlock Text="Xeonstrap"
                               Margin="9,0,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border Style="{StaticResource AuroraChipStyle}" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionChip" Style="{StaticResource AuroraChipTextStyle}" FontSize="10" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ======================= Body ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rail -->
            <Border Grid.Column="0" Style="{StaticResource AuroraRailStyle}" Padding="10,10,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource AuroraSearchSurfaceStyle}" Margin="2,0,2,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Search24"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock x:Name="SearchHint"
                                           Text="Search pages"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource AuroraInlineTextBoxStyle}"
                                         TextChanged="SearchBox_TextChanged" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             Style="{StaticResource AuroraNavListStyle}"
                             ItemContainerStyle="{StaticResource AuroraNavItemStyle}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource AuroraGroupHeaderStyle}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="2,8,2,0">
                        <Border Style="{StaticResource AuroraChipStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock x:Name="StatusText"
                                           Style="{StaticResource AuroraChipTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="PaletteButton"
                                Style="{StaticResource AuroraGhostButtonStyle}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Click="Palette_Click">
                            <Grid>
                                <TextBlock Text="Command palette" FontSize="12" HorizontalAlignment="Left" />
                                <TextBlock x:Name="PaletteHint"
                                           Text="Ctrl K"
                                           FontSize="10.5"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AuroraChromeBarStyle}" Padding="10,9,16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackButton"
                                    Style="{StaticResource AuroraIconButtonStyle}"
                                    Click="Back_Click"
                                    ToolTip="Back">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" />
                            </Button>
                            <Button x:Name="ForwardButton"
                                    Style="{StaticResource AuroraIconButtonStyle}"
                                    Click="Forward_Click"
                                    ToolTip="Forward">
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="13" />
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle"
                                       Style="{StaticResource AuroraPageTitleStyle}"
                                       FontSize="15"
                                       Text="Home" />
                            <TextBlock x:Name="PageSubtitle"
                                       Style="{StaticResource AuroraMutedStyle}"
                                       FontSize="11"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource AuroraChipStyle}" Margin="0,0,8,0">
                                <TextBlock x:Name="ChannelChip" Style="{StaticResource AuroraChipTextStyle}" FontSize="10.5" />
                            </Border>
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource AuroraGhostButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="Save_Click"
                                    ToolTip="Save pending changes">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SaveButtonLabel" Text="Save" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StudioButton"
                                    Style="{StaticResource AuroraSecondaryButtonStyle}"
                                    Padding="10,7"
                                    Margin="0,0,8,0"
                                    Click="Studio_Click"
                                    ToolTip="Launch Roblox Studio">
                                <ui:SymbolIcon Symbol="Play20" FontSize="13" />
                            </Button>
                            <Button x:Name="LaunchButton"
                                    Style="{StaticResource AuroraPrimaryButtonStyle}"
                                    Click="Launch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play20"
                                                   FontSize="12"
                                                   Foreground="#FFFFFFFF"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="Launch Roblox" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Frame x:Name="RootFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       JournalOwnership="OwnsJournal"
                       Navigated="RootFrame_Navigated" />
            </Grid>
        </Grid>
    </Grid>
</base:WpfUiWindow>
