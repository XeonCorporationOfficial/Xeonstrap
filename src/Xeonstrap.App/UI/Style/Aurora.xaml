  <Color x:Key="AccentTextFillColorPrimary">#FFF6F4FF</Color>
  <Color x:Key="AccentTextFillColorSecondary">#E6F6F4FF</Color>
  <Color x:Key="AccentTextFillColorTertiary">#CCF6F4FF</Color>
