<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Xeon Aurora Glass.

    A deliberate step past the previous Aurora dark layer: the ink is deeper and cooler,
    violet stays the brand colour but blue takes over the far end of the gradient, and
    every surface sits on a slightly stronger stroke so cards read as separate panes of
    glass instead of a single wash.

    Only colour tokens live here. RinUI.xaml rebuilds the brushes from these keys, and
    every theme layer (Dark, Light, Blue, ...) overrides the same small subset.
  -->

  <!-- ============================== Brand ============================== -->
  <Color x:Key="XeonAuroraAccent">#FF7C5CFF</Color>
  <Color x:Key="XeonAuroraAccentHover">#FFA08CFF</Color>
  <Color x:Key="XeonAuroraAccentPressed">#FF5F3FE0</Color>
  <Color x:Key="XeonAuroraBlue">#FF4F7CF6</Color>
  <Color x:Key="XeonAuroraMagenta">#FFC04CFF</Color>
  <Color x:Key="XeonAuroraInkDeep">#FF05040B</Color>
  <Color x:Key="XeonAuroraInk">#FF07060F</Color>
  <Color x:Key="XeonAuroraInkRaised">#FF121024</Color>
  <Color x:Key="XeonAuroraInkHigh">#FF1B1630</Color>
  <Color x:Key="XeonAuroraGlow">#4D7C5CFF</Color>

  <!-- ============================ Surfaces ============================ -->
  <Color x:Key="ApplicationBackgroundColor">#FF07060F</Color>
  <Color x:Key="ComboBoxPopupAcrylicBackground">#FF16132A</Color>

  <Color x:Key="ControlFillColorDefault">#14B9A5FF</Color>
  <Color x:Key="ControlFillColorSecondary">#1FB9A5FF</Color>
  <Color x:Key="ControlFillColorTertiary">#0FB9A5FF</Color>
  <Color x:Key="ControlFillColorDisabled">#0AB9A5FF</Color>
  <Color x:Key="ControlFillColorTransparent">#00FFFFFF</Color>
  <Color x:Key="ControlFillColorInputActive">#E60A0814</Color>
  <Color x:Key="ControlStrongFillColorDefault">#8FB9A5FF</Color>
  <Color x:Key="ControlStrongFillColorDisabled">#3FB9A5FF</Color>
  <Color x:Key="ControlSolidFillColorDefault">#FF1B1630</Color>

  <Color x:Key="SubtleFillColorTransparent">#00FFFFFF</Color>
  <Color x:Key="SubtleFillColorSecondary">#14B9A5FF</Color>
  <Color x:Key="SubtleFillColorTertiary">#0CB9A5FF</Color>

  <Color x:Key="ControlAltFillColorTransparent">#00FFFFFF</Color>
  <Color x:Key="ControlAltFillColorSecondary">#1A000000</Color>
  <Color x:Key="ControlAltFillColorTertiary">#0DB9A5FF</Color>
  <Color x:Key="ControlAltFillColorQuarternary">#16B9A5FF</Color>

  <Color x:Key="ControlStrokeColorDefault">#20B9A5FF</Color>
  <Color x:Key="ControlStrokeColorSecondary">#0D000000</Color>
  <Color x:Key="ControlStrokeColorOnAccentDefault">#22B9A5FF</Color>
  <Color x:Key="ControlStrokeColorOnAccentSecondary">#24000000</Color>
  <Color x:Key="ControlStrongStrokeColorDefault">#9FB9A5FF</Color>
  <Color x:Key="ControlStrongStrokeColorDisabled">#28B9A5FF</Color>

  <Color x:Key="CardBackgroundFillColorDefault">#0DB9A5FF</Color>
  <Color x:Key="CardBackgroundFillColorSecondary">#18C4B5FF</Color>
  <Color x:Key="CardStrokeColorDefault">#22B9A5FF</Color>
  <Color x:Key="CardStrokeColorDefaultSolid">#FF1B1630</Color>

  <Color x:Key="SolidBackgroundFillColorBase">#FF07060F</Color>
  <Color x:Key="SolidBackgroundFillColorBaseAlt">#FF05040B</Color>
  <Color x:Key="SolidBackgroundFillColorSecondary">#FF0B0917</Color>
  <Color x:Key="SolidBackgroundFillColorTertiary">#FF121024</Color>
  <Color x:Key="SolidBackgroundFillColorQuarternary">#FF191633</Color>
  <Color x:Key="MicaBackgroundFillColorBase">#FF07060F</Color>

  <Color x:Key="LayerFillColorDefault">#80121024</Color>
  <Color x:Key="LayerFillColorAlt">#80100E1E</Color>
  <Color x:Key="LayerOnAcrylicFillColorDefault">#4007060F</Color>
  <Color x:Key="LayerOnAccentAcrylicFillColorDefault">#407C5CFF</Color>
  <Color x:Key="SurfaceStrokeColorDefault">#22B9A5FF</Color>
  <Color x:Key="SurfaceStrokeColorFlyout">#33000000</Color>
  <Color x:Key="DividerStrokeColorDefault">#1CB9A5FF</Color>
  <Color x:Key="SmokeFillColorDefault">#4D07060F</Color>

  <!-- ============================== Text ============================== -->
  <Color x:Key="TextFillColorPrimary">#FFF6F4FF</Color>
  <Color x:Key="TextFillColorSecondary">#C6BFDC</Color>
  <Color x:Key="TextFillColorTertiary">#928BAE</Color>
  <Color x:Key="TextFillColorDisabled">#5E5878</Color>
