  <Color x:Key="TextOnAccentFillColorSecondary">#E6FFFFFF</Color>
  <Color x:Key="TextOnAccentFillColorDisabled">#7AFFFFFF</Color>
  <Color x:Key="TextOnAccentFillColorSelectedText">#FFFFFFFF</Color>
  <Color x:Key="AccentFillColorSelectedTextBackground">#FF7C5CFF</Color>

  <Color x:Key="FocusStrokeColorOuter">#FFFFFFFF</Color>
  <Color x:Key="FocusStrokeColorInner">#B307060F</Color>
  <Color x:Key="KeyboardFocusBorderColor">#FFFFFFFF</Color>

  <!-- ============================= System ============================= -->
  <Color x:Key="SystemFillColorSuccess">#FF3BD6A0</Color>
  <Color x:Key="SystemFillColorCaution">#FFFFC24B</Color>
  <Color x:Key="SystemFillColorCritical">#FFFF6B8A</Color>
  <Color x:Key="SystemFillColorNeutral">#FFB9A5FF</Color>
  <Color x:Key="SystemFillColorSolidNeutral">#FFB9A5FF</Color>
  <Color x:Key="SystemFillColorSolidNeutralBackground">#FF121024</Color>
  <Color x:Key="SystemFillColorSolidSuccessBackground">#FF0F2C25</Color>
  <Color x:Key="SystemFillColorSolidCautionBackground">#FF35280F</Color>
  <Color x:Key="SystemFillColorSolidCriticalBackground">#FF35131E</Color>
  <Color x:Key="SystemFillColorSolidAttentionBackground">#FF221D3A</Color>

  <!-- =========================== Rin tokens =========================== -->
  <Color x:Key="RinPrimaryColor">#FF7C5CFF</Color>
  <Color x:Key="RinControlBorderColor">#22B9A5FF</Color>
  <Color x:Key="RinTextControlBorderColor">#8FB9A5FF</Color>
  <Color x:Key="RinCaptionCloseColor">#FFC42B1C</Color>
  <Color x:Key="RinCaptionCloseTextColor">#FFFFFFFF</Color>

  <!-- Card ramp used by the Aurora component layer. -->
  <Color x:Key="XeonAuroraCardBackground">#0DB9A5FF</Color>
  <Color x:Key="XeonAuroraCardBorder">#22B9A5FF</Color>
  <Color x:Key="XeonAuroraCardBorderHover">#44B9A5FF</Color>

  <!-- Editor and window brushes that live outside the token set. -->
  <SolidColorBrush x:Key="NewTextEditorBackground" Color="#CC110E22" />
  <SolidColorBrush x:Key="NewTextEditorForeground" Color="#FFF6F4FF" />
  <SolidColorBrush x:Key="NewTextEditorLink" Color="#FFA08CFF" />
  <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#FF07060F" />
  <Color x:Key="WindowBackgroundColorPrimary">#FF07060F</Color>
  <Color x:Key="WindowBackgroundColorSecondary">#FF171034</Color>
  <Color x:Key="WindowBackgroundColorThird">#FF0B0917</Color>
  <Color x:Key="WindowBackgroundColorTertiary">#FF0B0917</Color>
  <Color x:Key="WindowBackgroundColorPrimaryWithOpacity">#8007060F</Color>
  <Color x:Key="WindowBackgroundColorSecondaryWithOpacity">#80171034</Color>
  <Color x:Key="WindowBackgroundColorThirdWithOpacity">#800B0917</Color>
  <Color x:Key="WindowBackgroundColorTertiaryWithOpacity">#800B0917</Color>

</ResourceDictionary>
