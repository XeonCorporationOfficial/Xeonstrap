<ui:UiPage x:Class="Xeonstrap.UI.Elements.Installer.Pages.CompletionPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           Title="Done"
           Scrollable="True"
           Loaded="UiPage_Loaded">

    <StackPanel Margin="{StaticResource AuroraPagePadding}" MaxWidth="760" HorizontalAlignment="Left">

        <TextBlock Text="{resources:Loc Installer_Completion_Settings_Title}"
                   Style="{StaticResource AuroraDisplayStyle}"
                   FontSize="24" />
        <TextBlock Margin="0,8,0,18"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{Binding CompletionText}" />

        <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="0,0,0,10" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="Settings28" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{resources:Loc Installer_Completion_Settings_Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Text="{resources:Loc Installer_Completion_Settings_Description}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Button>

        <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="0,0,0,10" Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="ArrowExit20" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{resources:Loc Installer_Completion_Launch_Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Text="{resources:Loc Installer_Completion_Launch_Description}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Button>

        <Button Style="{StaticResource AuroraCardButtonStyle}" Command="{Binding OpenAboutCommand, Mode=OneTime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="QuestionCircle32" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{resources:Loc Menu_About_Title}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Text="{resources:Loc Menu_About_Description}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Button>
    </StackPanel>
</ui:UiPage>
