<ui:UiPage x:Class="Xeonstrap.UI.Elements.Installer.Pages.ChannelPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           Title="Channel"
           Scrollable="True"
           Loaded="UiPage_Loaded"
           Unloaded="UiPage_Unloaded">

    <StackPanel Margin="{StaticResource AuroraPagePadding}" MaxWidth="820" HorizontalAlignment="Left">

        <TextBlock Text="{resources:Loc Ui_Misc2_DownloadServer}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />
        <TextBlock Margin="0,6,0,16"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{resources:Loc Ui_Misc2_ChooseTheServerUsedWhenRoblox}" />

        <Border Style="{StaticResource AuroraCardStyle}">
            <StackPanel>
                <controls:OptionControl Margin="0,0,0,4"
                                        Header="{resources:Loc Ui_Channel_DownloadServer}"
                                        Description="{resources:Loc Ui_Channel_UsedWhenRobloxIsInstalledOr}">
                    <ComboBox MinWidth="300" Height="35" Padding="10,5,10,5" VerticalContentAlignment="Center"
                              DisplayMemberPath="Display"
                              ItemsSource="{Binding Mirrors}"
                              SelectedItem="{Binding SelectedMirror, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,20,0,0" Text="{resources:Loc Menu_Behaviour_Channel_Title}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="16" />
        <TextBlock Margin="0,4,0,12"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{resources:Loc Ui_Misc2_TheDeploymentChannelRobloxIsInstalled}" />

        <Border Style="{StaticResource AuroraCardStyle}">
            <StackPanel>
                <controls:OptionControl Margin="0,0,0,4"
                                        Header="{resources:Loc Ui_Misc2_PreferredChannel}"
                                        Description="{resources:Loc Ui_Misc2_LeaveThisAsProductionUnlessYou}">
                    <ui:TextBox MinWidth="300" Height="35" VerticalContentAlignment="Center"
                                PlaceholderText="Production"
                                Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:UiPage>
