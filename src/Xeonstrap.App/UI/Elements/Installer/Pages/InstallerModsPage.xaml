<ui:UiPage x:Class="Xeonstrap.UI.Elements.Installer.Pages.InstallerModsPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           Title="{resources:Loc Menu_Mods_Title}"
           Scrollable="True"
           Loaded="UiPage_Loaded"
           Unloaded="UiPage_Unloaded">

    <StackPanel Margin="{StaticResource AuroraPagePadding}" MaxWidth="820" HorizontalAlignment="Left">

        <TextBlock Text="{resources:Loc Menu_Mods_Title}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />
        <TextBlock Margin="0,6,0,16"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{resources:Loc Menu_Mods_Description}" />

        <TextBlock Text="{resources:Loc Common_Presets}" Style="{StaticResource AuroraSectionTitleStyle}" Margin="2,0,0,8" />

        <Border Style="{StaticResource AuroraCardStyle}">
            <StackPanel>
                <controls:OptionControl Margin="0,0,0,2"
                                        Header="{resources:Loc Menu_Mods_Presets_MouseCursor_Title}"
                                        Description="{resources:Loc Menu_Mods_Presets_MouseCursor_Description}">
                    <ComboBox Width="210" Height="35" Padding="10,5,10,5" VerticalContentAlignment="Center"
                              ItemsSource="{Binding CursorStyles, Mode=OneTime}"
                              SelectedItem="{Binding SelectedCursorType, Mode=TwoWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Margin="0,0,0,2"
                                        Header="{resources:Loc Menu_Mods_Presets_OldCharacterSounds_Title}"
                                        Description="{resources:Loc Menu_Mods_Presets_OldCharacterSounds_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Margin="0,0,0,2"
                                        Header="{resources:Loc Menu_Mods_Presets_OldDeathSound_Title}"
                                        Description="{resources:Loc Menu_Mods_Presets_OldDeathSound_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding OldDeathSoundTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Margin="0,0,0,2"
                                        Header="{resources:Loc Menu_Mods_Presets_OldAvatarEditor_Title}"
                                        Description="{resources:Loc Menu_Mods_Presets_OldAvatarEditor_Description}">
                    <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:UiPage>
