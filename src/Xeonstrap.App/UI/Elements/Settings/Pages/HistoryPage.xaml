<Page x:Class="Xeonstrap.UI.Elements.Settings.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Xeonstrap.Resources"
      xmlns:util="clr-namespace:Xeonstrap.Utility"
      Title="{resources:Loc Ui_Pages_History}">

    <Grid Margin="{StaticResource AuroraPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Pages_History}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource AuroraMutedStyle}" Text="{resources:Loc Ui_Pages_ContinueWhereYouLeftOff}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AuroraSecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AuroraSecondaryButtonStyle}" Margin="8,0,0,0" Command="{Binding ClearCommand}">
                    <TextBlock Text="{resources:Loc Ui_Pages_ClearAll}" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource AuroraSearchSurfaceStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Search24" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource AuroraInlineTextBoxStyle}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{resources:Loc Ui_Pages_SearchByGameNameCreatorOr}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="12"
                   Margin="2,0,0,10"
                   TextWrapping="Wrap"
                   Text="{Binding Error}" />

        <Grid Grid.Row="3">
            <!-- Empty states -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="46,34" MaxWidth="420"
                    Style="{StaticResource AuroraCardStyle}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ui:SymbolIcon Symbol="History24" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                    </Border>
                    <TextBlock Text="{resources:Loc Ui_Home_NoHistoryYet}" FontSize="16" FontWeight="SemiBold"
                               Margin="0,14,0,5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{resources:Loc Ui_Home_GamesYouPlayWillShowUp}" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="46,34" MaxWidth="420"
                    Style="{StaticResource AuroraCardStyle}"
                    Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                    </Border>
                    <TextBlock Text="{resources:Loc Ui_Home_NoMatches}" FontSize="16" FontWeight="SemiBold"
                               Margin="0,14,0,5" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{resources:Loc Ui_Home_NothingInYourHistoryMatchesThat}" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <ui:DynamicScrollViewer VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding FilteredHistory}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AuroraCardStyle}"
                                    Margin="0,0,12,12"
                                    Padding="0"
                                    Width="228">
                                <StackPanel>
                                    <Border Height="124" CornerRadius="16,16,0,0" ClipToBounds="True"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="Games28" FontSize="30" Opacity="0.4"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Stretch="UniformToFill"
                                                   Source="{Binding ThumbnailUrl, Converter={StaticResource WindowsOnlyImageSourceConverter}, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                   util:DynamicRenderSystem.LinuxImageSource="{Binding ThumbnailUrl}">
                                                <FrameworkElement.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="False" Binding="{Binding HasThumbnail}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </FrameworkElement.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="14,10,14,0">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Name}" ToolTip="{Binding Name}" />
                                        <TextBlock FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding CreatorName}">
                                            <FrameworkElement.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="" Binding="{Binding CreatorName}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </FrameworkElement.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <ui:SymbolIcon Symbol="ThumbLike24" FontSize="13" Opacity="0.7" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12" Margin="4,0,12,0" Opacity="0.75" VerticalAlignment="Center" Text="{Binding LikePercent}" />
                                            <ui:SymbolIcon Symbol="People24" FontSize="13" Opacity="0.7" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12" Margin="4,0,0,0" Opacity="0.75" VerticalAlignment="Center" Text="{Binding PlayerCount}" />
                                        </StackPanel>

                                        <TextBlock FontSize="10.5" Opacity="0.5" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                            <Run Text="{resources:Loc Ui_Home_Joined}" />
                                            <Run Text="{Binding TimeJoined, StringFormat={}{0:MMM d, yyyy  h:mm tt}, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Margin="14,10,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Button Grid.Column="0" Icon="Play24" Appearance="Primary"
                                                   ToolTip="{resources:Loc Ui_Pages_Play}" HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Grid.Column="2" Icon="Copy24" Appearance="Secondary"
                                                   ToolTip="{resources:Loc Ui_Home_CopyGameLink}"
                                                   Command="{Binding DataContext.CopyLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>

                                    <ComboBox Margin="14,8,14,0" Padding="8,4,8,4" FontSize="12"
                                              ToolTip="{Binding DatacenterToolTip}" ToolTipService.ShowOnDisabled="True"
                                              DisplayMemberPath="Display"
                                              IsEnabled="{Binding MatchmakerEnabledForGame}"
                                              ItemsSource="{Binding DatacenterOptions}"
                                              SelectedItem="{Binding SelectedDatacenter, Mode=TwoWay}" />

                                    <ui:Button Margin="14,8,14,14" HorizontalAlignment="Stretch" FontSize="12"
                                               Icon="{Binding SkipMatchmakerIcon}"
                                               Content="{Binding SkipMatchmakerLabel}"
                                               ToolTip="{Binding SkipMatchmakerTooltip}"
                                               Command="{Binding ToggleSkipMatchmakerCommand}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:DynamicScrollViewer>
        </Grid>
    </Grid>
</Page>
