<ui:UiPage x:Class="Xeonstrap.UI.Elements.Settings.Pages.GamePage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           Title="Game"
           ui:Breadcrumb.Header="{resources:Loc Ui_Pages_GameDetails}"
           Loaded="GamePage_Loaded"
           Unloaded="GamePage_Unloaded"
           Scrollable="True">

    <StackPanel Margin="{StaticResource AuroraPagePadding}">

        <!-- Hero -->
        <Border Style="{StaticResource AuroraHeroStyle}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        ClipToBounds="True"
                        CornerRadius="12"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        MinHeight="235">
                    <Grid>
                        <ui:SymbolIcon Symbol="Games28" FontSize="42" Opacity="0.25"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="BannerImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                    <TextBlock x:Name="GameTitleText"
                               FontSize="30"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{resources:Loc Ui_Misc2_Loading}" />

                    <TextBlock x:Name="CreatorText"
                               FontSize="14"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="" />

                    <TextBlock x:Name="GenreText"
                               FontSize="13"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="" />

                    <ui:Button x:Name="PlayButton"
                               Margin="0,24,0,0"
                               Height="45"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               Appearance="Primary"
                               Icon="Play24"
                               FontSize="20"
                               Click="PlayButton_Click" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ThumbLike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                            <TextBlock x:Name="LikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ThumbDislike24" FontSize="16" Opacity="0.85" VerticalAlignment="Center" />
                            <TextBlock x:Name="DislikesText" Margin="6,0,0,0" FontSize="14" VerticalAlignment="Center" Text="--" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="RatingBar"
                                 Margin="0,8,0,0"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Description -->
        <Border x:Name="DescriptionCard" Style="{StaticResource AuroraCardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Pages_GameDetails}" Style="{StaticResource AuroraSectionTitleStyle}" Margin="0,0,0,8" />
                <TextBlock x:Name="DescriptionText"
                           FontSize="13.5"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="" />
            </StackPanel>
        </Border>

        <!-- Stats -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{resources:Loc Ui_Misc2_Active}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ActiveText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{resources:Loc ContextMenu_GameBrowser_Favorites}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="FavoritesText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{resources:Loc Ui_Pages_Visits}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="VisitsText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="{resources:Loc Ui_Pages_Created}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CreatedText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="{resources:Loc Ui_Pages_Updated}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="UpdatedText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="5">
                    <TextBlock Text="{resources:Loc Ui_Misc2_ServerSize}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ServerSizeText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="{resources:Loc Ui_Pages_Genre}" Style="{StaticResource AuroraMutedStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GenreStatText" Text="--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</ui:UiPage>
