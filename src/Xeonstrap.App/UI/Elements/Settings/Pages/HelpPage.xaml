<ui:UiPage x:Class="Xeonstrap.UI.Elements.Settings.Pages.HelpPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           Title="Help"
           Scrollable="True">

    <StackPanel Margin="{StaticResource AuroraPagePadding}">

        <TextBlock Text="Help"
                   Style="{StaticResource AuroraDisplayStyle}"
                   FontSize="24" />
        <TextBlock Margin="0,6,0,18"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{resources:Loc Ui_Misc2_ProvidesInfoOnFFlagsFeatures}" />

        <Grid MinHeight="520">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AuroraCardStyle}" Margin="0,0,6,0" Padding="14">
                <controls:Expander HeaderIcon="ErrorCircle24"
                                   HeaderText="{resources:Loc Ui_Misc2_CommonFFlagIssues}"
                                   IsExpanded="True">
                    <StackPanel>
                        <controls:MarkdownTextBlock MarkdownText="[Gray Avatars](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Blurry Icons Textures](https://www.reddit.com/r/RobloxHelp/comments/1hxmcdi/roblox_textures_are_blurry_and_the_staff_do/)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Laggy Animation](https://devforum.roblox.com/t/roblox-settings-ui-quality-is-affected-by-game-graphics-bar-slider/3064536)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Frame Stutters](https://devforum.roblox.com/t/everything-loads-extremely-slow/3789261)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Lighting Problems](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Gray Sky](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Black Textures](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Rainbow UI Textures](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Loading Issues](https://devforum.roblox.com/t/everything-loads-extremely-slow/3789261)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[FPS Capped When Uncapped](https://github.com/bloxstraplabs/bloxstrap/issues/2447)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Quality Level Not Changing](https://devforum.roblox.com/t/roblox-settings-ui-quality-is-affected-by-game-graphics-bar-slider/3064536)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Black Sky](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Roblox Crashing](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[White Sky and White Screen](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Crash on Fast Camera Turn](https://devforum.roblox.com/t/roblox-settings-ui-quality-is-affected-by-game-graphics-bar-slider/3064536)" Margin="0,0,0,4" />
                    </StackPanel>
                </controls:Expander>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource AuroraCardStyle}" Margin="6,0,6,0" Padding="14">
                <controls:Expander HeaderIcon="ErrorCircle24"
                                   HeaderText="{resources:Loc Ui_Misc2_Features}"
                                   IsExpanded="True">
                    <StackPanel>
                        <controls:MarkdownTextBlock MarkdownText="[Recommended Buffering](https://github.com/1x4z/1#recommended-buffering)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Rendering Modes](https://github.com/1x4z/1#rendering-modes)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Override Graphic Quality](https://github.com/1x4z/1#override-graphic-quality)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Texture Skipping](https://github.com/1x4z/1#texture-skipping)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Disable Full-Screen TitleBar](https://github.com/1x4z/1#disable-full-screen-titlebar)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Telemetry](https://github.com/1x4z/1#telemetry)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[ReduceLagSpikes](https://github.com/1x4z/1#reducelagspikes)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[LargeReplicator](https://github.com/1x4z/1#largereplicator)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[RCore](https://github.com/1x4z/1#rcore)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Payload Limit](https://github.com/1x4z/1#payload-limit)" Margin="0,0,0,4" />
                    </StackPanel>
                </controls:Expander>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AuroraCardStyle}" Margin="6,0,0,0" Padding="14">
                <controls:Expander HeaderIcon="AppsAddIn28"
                                   HeaderText="{resources:Loc Ui_Misc2_BootstrapperIssues}"
                                   IsExpanded="True">
                    <StackPanel>
                        <controls:MarkdownTextBlock MarkdownText="[Discord Rich-Presence Not Working](https://github.com/pizzaboxer/bloxstrap/issues/2972)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Setup Failed](https://bloxstrape.com/bloxstrap-error-and-fixes-in-2025/)" Margin="0,0,0,4" />
                        <controls:MarkdownTextBlock MarkdownText="[Connectivity Issue](https://devforum.roblox.com/t/texture-slow-loading-not-loading-at-all-and-result-in-grey-blank-character-constantly/2338035)" Margin="0,0,0,4" />
                    </StackPanel>
                </controls:Expander>
            </Border>
        </Grid>
    </StackPanel>
</ui:UiPage>
