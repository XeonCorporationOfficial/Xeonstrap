<ui:UiPage xmlns:resources="clr-namespace:Xeonstrap.Resources"
           x:Class="Xeonstrap.UI.Elements.Settings.Pages.ReleasesPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:conv="clr-namespace:Xeonstrap.UI.Converters"
           x:Name="ReleasesView"
           Title="{resources:Loc Ui_Misc2_Releases}"
           Scrollable="True">

    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <Grid Margin="{StaticResource AuroraPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{resources:Loc Ui_Misc2_Releases}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />

        <Border Grid.Row="1" Style="{StaticResource AuroraSearchSurfaceStyle}" Margin="0,12,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Search24" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         Style="{StaticResource AuroraInlineTextBoxStyle}"
                         ToolTip="{resources:Loc Ui_Misc2_SearchReleases}"
                         TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <ui:DynamicScrollViewer Grid.Row="2"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Style="{StaticResource AuroraChipStyle}" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource AuroraChipTextStyle}"
                                                       Foreground="{DynamicResource AuroraAccentHoverBrush}"
                                                       Text="{Binding TagName}" />
                                        </Border>
                                        <Border Style="{StaticResource AuroraChipStyle}" Margin="0,0,6,0"
                                                Visibility="{Binding Prerelease, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource AuroraChipTextStyle}"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Text="{resources:Loc Ui_Misc2_PreRelease}" />
                                        </Border>
                                        <Border Style="{StaticResource AuroraChipStyle}"
                                                Visibility="{Binding Draft, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource AuroraChipTextStyle}"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Text="{resources:Loc Ui_Misc2_Draft}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,4,0,0" Style="{StaticResource AuroraMutedStyle}"
                                           Text="{Binding PublishedAt, StringFormat=Published: {0:yyyy-MM-dd HH:mm}}" />

                                <TextBlock Margin="0,8,0,0">
                                    <Hyperlink NavigateUri="{Binding HtmlUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                        <Run Text="{resources:Loc Ui_Misc2_ViewOnGitHub}" />
                                    </Hyperlink>
                                </TextBlock>

                                <TextBox Margin="0,8,0,4"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="132"
                                         FontSize="12.5"
                                         Text="{Binding Body}" />

                                <StackPanel Margin="0,6,0,2" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,14,0" Style="{StaticResource AuroraMutedStyle}"
                                               Text="{Binding Assets.Length, StringFormat=Assets: {0}}" />
                                    <TextBlock Style="{StaticResource AuroraMutedStyle}"
                                               Text="{Binding TotalDownloads, StringFormat=Total downloads: {0}}" />
                                </StackPanel>

                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Assets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2,0,2" Padding="10,6" CornerRadius="8"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,10,0">
                                                        <Hyperlink NavigateUri="{Binding BrowserDownloadUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                                                            <Run Text="{Binding Name}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,0,10,0" Style="{StaticResource AuroraMutedStyle}"
                                                               Text="{Binding SizeMb, StringFormat=({0:F2} MB)}" />
                                                    <TextBlock Margin="0,0,10,0" Style="{StaticResource AuroraMutedStyle}"
                                                               Text="{Binding DownloadCount, StringFormat=Downloads: {0}}" />
                                                    <TextBlock Style="{StaticResource AuroraMutedStyle}" Text="{Binding ContentType}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:DynamicScrollViewer>
    </Grid>
</ui:UiPage>
