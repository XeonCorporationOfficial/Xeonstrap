<ui:UiPage x:Class="Xeonstrap.UI.Elements.Settings.Pages.NewsPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:conv="clr-namespace:Xeonstrap.UI.Converters"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           xmlns:appUi="clr-namespace:Xeonstrap.UI"
           Title="{resources:Loc Ui_Nav_News}"
           Scrollable="True">

    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <DataTemplate x:Key="NewBadge">
                <Border Margin="8,0,0,0"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        CornerRadius="999"
                        Background="{DynamicResource AccentFillColorPrimaryBrush}"
                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}"
                        appUi:LinuxTextGuard.PreserveCompactLayout="True">
                    <TextBlock FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               Text="{Binding AgeLabel}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <StackPanel Margin="{StaticResource AuroraPagePadding}">

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Nav_News}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource AuroraMutedStyle}" Text="{Binding LastUpdatedText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource AuroraSecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{resources:Loc Common_Refresh}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ui:InfoBar Margin="0,0,0,12"
                    Severity="Warning"
                    IsClosable="False"
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorText}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowLoader, Converter={StaticResource BoolToVis}}">
            <ui:ProgressRing Width="36" Height="36" IsIndeterminate="True" />
            <TextBlock Margin="0,12,0,0" Text="{resources:Loc Menu_News_Loading}" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
            <ui:SymbolIcon Symbol="News24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Margin="0,10,0,0" Text="{resources:Loc Ui_Misc2_NoNewsYet}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0" Text="{resources:Loc Ui_Misc2_NewXeonstrapUpdatesAndAnnouncementsWill}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <Button Style="{StaticResource AuroraCardButtonStyle}"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                DataContext="{Binding FeaturedItem}"
                Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                Click="OpenItem_Click">
            <StackPanel>
                <Border Height="240" CornerRadius="16,16,0,0" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Margin="22,18,22,22">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DateText}" VerticalAlignment="Center" />
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NewBadge}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" FontSize="13" LineHeight="20" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" />
                    <TextBlock Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AuroraAccentHoverBrush}" Text="{resources:Loc Ui_Misc2_ReadMore}" />
                </StackPanel>
            </StackPanel>
        </Button>

        <TextBlock Margin="2,26,0,10"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="{resources:Loc Ui_Misc2_Earlier}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Visibility="{Binding HasMoreItems, Converter={StaticResource BoolToVis}}" />

        <ItemsControl ItemsSource="{Binding MoreItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource AuroraCardButtonStyle}"
                            Margin="0,0,0,8"
                            Padding="12"
                            HorizontalContentAlignment="Stretch"
                            Click="OpenItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="112" Height="64" Margin="0,0,14,0" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="News24" FontSize="22" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" Width="112" Height="64" Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,112,64" RadiusX="8" RadiusY="8" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NewBadge}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding DateText}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Summary}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ui:UiPage>
