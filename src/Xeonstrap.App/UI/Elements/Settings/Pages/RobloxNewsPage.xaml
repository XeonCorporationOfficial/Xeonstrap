<Page x:Class="Xeonstrap.UI.Elements.Settings.Pages.RobloxNewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:util="clr-namespace:Xeonstrap.Utility"
      xmlns:conv="clr-namespace:Xeonstrap.UI.Converters"
      xmlns:resources="clr-namespace:Xeonstrap.Resources"
      Title="{resources:Loc Ui_Misc2_RobloxNews}"
      ui:Breadcrumb.Header="{resources:Loc Ui_Home_LatestRobloxNews}">

    <Page.Resources>
        <conv:InvertBooleanToVisibilityConverter x:Key="InvertBoolToVis" />
    </Page.Resources>

    <Grid Margin="{StaticResource AuroraPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Misc2_RobloxNews}"
                           Style="{StaticResource AuroraDisplayStyle}"
                           FontSize="24" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource AuroraMutedStyle}"
                           Text="{Binding Status}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AuroraSecondaryButtonStyle}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{resources:Loc ContextMenu_ServerBrowser_Refresh}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AuroraSecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Command="{Binding OpenFeedCommand}"
                        ToolTip="{resources:Loc Ui_Misc2_OpenTheAnnouncementsFeedInYour}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Open24" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{resources:Loc Ui_Misc2_OpenFeed}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{resources:Loc Ui_Misc2_LoadingTheLatestRobloxAnnouncements}"
                   FontSize="14"
                   Margin="0,26,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <ui:DynamicScrollViewer Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                Visibility="{Binding HasPosts, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Posts}" Margin="0,0,0,18">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="PostRow"
                                Margin="0,0,0,12"
                                Padding="0"
                                CornerRadius="{StaticResource AuroraCardRadius}"
                                ClipToBounds="True"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Cursor="Hand"
                                ToolTip="{Binding Title}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenPostCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PostImageHost"
                                        Width="178"
                                        Height="104"
                                        Margin="10"
                                        CornerRadius="8"
                                        RenderOptions.BitmapScalingMode="LowQuality"
                                        util:DynamicRenderSystem.BrushDecodeWidth="360"
                                        util:DynamicRenderSystem.BrushImageSource="{Binding ImageUrl}">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.RelativeTransform>
                                                <ScaleTransform x:Name="PostZoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                            </ImageBrush.RelativeTransform>
                                        </ImageBrush>
                                    </Border.Background>
                                    <ui:SymbolIcon Symbol="News24"
                                                   FontSize="26"
                                                   Opacity="0.3"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasImage, Converter={StaticResource InvertBoolToVis}}" />
                                </Border>

                                <ui:ProgressRing Width="24"
                                                 Height="24"
                                                 Margin="10"
                                                 IsIndeterminate="True"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding Background.(util:DynamicRenderSystem.IsBrushLoading),
                                                     ElementName=PostImageHost,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Grid.Column="1" Margin="16,13,12,13" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Border Padding="8,2"
                                                CornerRadius="999"
                                                Background="{DynamicResource AccentFillColorPrimaryBrush}"
                                                Visibility="{Binding TagVisibility}">
                                            <TextBlock Text="{Binding Tag}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding DateLabel}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AuroraAccentHoverBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="42"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               MaxHeight="32"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatsLabel}"
                                               FontSize="11"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Width="22"
                                        Height="22"
                                        Margin="0,0,16,0"
                                        CornerRadius="11"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowRight24"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="PostRow" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PostRow" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <EventTrigger SourceName="PostRow" RoutedEvent="Border.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PostZoom"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.05" Duration="0:0:0.55">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PostZoom"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.05" Duration="0:0:0.55">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger SourceName="PostRow" RoutedEvent="Border.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PostZoom"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.65">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PostZoom"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.65">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:DynamicScrollViewer>
    </Grid>
</Page>
