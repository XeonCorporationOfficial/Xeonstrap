<ui:UiPage x:Class="Xeonstrap.UI.Elements.Settings.Pages.GBSEditorPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:platform="clr-namespace:Xeonstrap.UI"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:resources="clr-namespace:Xeonstrap.Resources"
           xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls"
           xmlns:sys="clr-namespace:System;assembly=mscorlib"
           Title="{resources:Loc Ui_Nav_Global}"
           Scrollable="True">

    <StackPanel Margin="{StaticResource AuroraPagePadding}">

        <TextBlock Text="{resources:Loc Ui_Nav_Global}" Style="{StaticResource AuroraDisplayStyle}" FontSize="24" />
        <TextBlock Margin="0,6,0,16"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="{resources:Loc Ui_Gbs_TheseAreRobloxSOwnIn}" />

        <!-- File and source -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <controls:ProfilesExpander Kind="Global" />
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_ResetToDefaultSettings}" Description="{resources:Loc Ui_Gbs_RestoreAllPreferencesToDefault}">
                    <Button Style="{StaticResource AuroraSecondaryButtonStyle}" Content="{resources:Loc Common_Reset}" Width="120" Command="{Binding ResetToDefaultsCommand}" />
                </controls:OptionControl>
                <TextBlock Text="{resources:Loc Ui_Gbs_SettingsFile}" Style="{StaticResource AuroraSectionTitleStyle}" Margin="0,12,0,6" />
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_LockSettingsFile}" Description="{resources:Loc Ui_Gbs_MarksTheRobloxSettingsFileRead}">
                    <ui:ToggleSwitch IsChecked="{Binding SettingsFileReadOnly, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Interface -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Mods_Interface}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_UITransparency}" Description="{resources:Loc Ui_Gbs_SetYourPreferredInterfaceTransparency}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding UITransparency, Mode=TwoWay}" Width="200" />
                        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UITransparency, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_TextSize}" Description="{resources:Loc Ui_Gbs_ControlsTheOverallUITextSize}">
                    <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding PreferredTextSize, Mode=TwoWay}">
                        <ComboBoxItem Content="Small"><FrameworkElement.Tag><sys:Int32>0</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Normal"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Large"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_ReducedMotion}" Description="{resources:Loc Ui_Gbs_DisableUIAnimationsForAccessibility}">
                    <ui:ToggleSwitch IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_HUDVisibility}" Description="{resources:Loc Ui_Gbs_ShowOrHideTheInGame}">
                    <ui:ToggleSwitch IsChecked="{Binding HudVisible, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_ChatVisibility}" Description="{resources:Loc Ui_Gbs_ShowOrHideTheInGame2}">
                    <ui:ToggleSwitch IsChecked="{Binding ChatVisible, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_PlayerNamesVisible}" Description="{resources:Loc Ui_Gbs_ShowOtherPlayerNames}">
                    <ui:ToggleSwitch IsChecked="{Binding PlayerNamesEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="{resources:Loc Ui_Gbs_BadgeVisible}" Description="{resources:Loc Ui_Gbs_ShowBadgeNotificationsWhilePlaying}">
                    <ui:ToggleSwitch IsChecked="{Binding BadgeVisible, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Graphics -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Gbs_Graphics}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_FramerateCap}" Description="{resources:Loc Ui_Gbs_LimitMaximumFPS}">
                    <ui:TextBox Width="100" MaxLength="5" PreviewTextInput="ValidateUInt32" Text="{Binding FramerateCap, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_GraphicsQuality}" Description="{resources:Loc Ui_Gbs_ChooseAutomaticOrSetAFixed}">
                    <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding GraphicsQuality, Mode=TwoWay}">
                        <ComboBoxItem Content="Automatic"><FrameworkElement.Tag><sys:Int32>0</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="1 (Lowest)"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="2"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="3"><FrameworkElement.Tag><sys:Int32>3</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="4"><FrameworkElement.Tag><sys:Int32>4</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="5"><FrameworkElement.Tag><sys:Int32>5</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="6"><FrameworkElement.Tag><sys:Int32>6</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="7"><FrameworkElement.Tag><sys:Int32>7</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="8"><FrameworkElement.Tag><sys:Int32>8</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="9"><FrameworkElement.Tag><sys:Int32>9</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="10 (Highest)"><FrameworkElement.Tag><sys:Int32>10</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_Fullscreen}" Description="{resources:Loc Ui_Gbs_ToggleFullscreenMode}">
                    <ui:ToggleSwitch IsChecked="{Binding Fullscreen, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Audio -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Gbs_Audio}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_MasterVolume}" Description="{resources:Loc Ui_Gbs_OverallInGameVolume}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding MasterVolume, Mode=TwoWay}" Width="200" />
                        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_VoiceChatVolume}" Description="{resources:Loc Ui_Gbs_VolumeForVoiceCommunication}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding VoiceChatVolume, Mode=TwoWay}" Width="200" />
                        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding VoiceChatVolume, StringFormat={}{0:P0}}" />
                    </StackPanel>
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Input -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Gbs_InputAndControls}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_MouseSensitivity}" Description="{resources:Loc Ui_Gbs_AdjustMouseSensitivity}">
                    <ui:TextBox Width="100" MaxLength="6" PreviewTextInput="ValidateFloat" Text="{Binding MouseSensitivity, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_InvertYAxis}" Description="{resources:Loc Ui_Gbs_ReverseTheVerticalCameraDirection}">
                    <ui:ToggleSwitch IsChecked="{Binding CameraYInverted, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_GamepadSensitivity}" Description="{resources:Loc Ui_Gbs_AdjustJoystickSensitivity}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Minimum="0.1" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding GamepadSensitivity, Mode=TwoWay}" Width="200" />
                        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GamepadSensitivity, StringFormat={}{0:0.0}}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_EnableControllerVibration}" Description="{resources:Loc Ui_Gbs_ToggleHapticFeedbackOnControllers}">
                    <ui:ToggleSwitch IsChecked="{Binding ControllerVibration, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Network -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Gbs_Network}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_NetworkDebugStats}" Description="{resources:Loc Ui_Gbs_ShowNetworkPingAndPacketStats}">
                    <ui:ToggleSwitch IsChecked="{Binding NetworkStatsVisible, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_ChatTranslation}" Description="{resources:Loc Ui_Gbs_AutomaticallyTranslateChatMessages}">
                    <ui:ToggleSwitch IsChecked="{Binding ChatTranslationEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Virtual reality -->
        <Border Style="{StaticResource AuroraCardStyle}" Margin="0,0,0,12"
                Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Gbs_VirtualReality}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_EnableVR}" Description="{resources:Loc Ui_Gbs_ToggleVirtualRealityMode}">
                    <ui:ToggleSwitch IsChecked="{Binding VREnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_VRComfortSetting}" Description="{resources:Loc Ui_Gbs_ControlsCameraMovementInVR}">
                    <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding VRComfortSetting, Mode=TwoWay}">
                        <ComboBoxItem Content="Comfort"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Normal"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                        <ComboBoxItem Content="Intense"><FrameworkElement.Tag><sys:Int32>3</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
                    </ComboBox>
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_VignetteInVR}" Description="{resources:Loc Ui_Gbs_EnableVignetteForMotionSicknessReduction}">
                    <ui:ToggleSwitch IsChecked="{Binding VignetteEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Style="{StaticResource AuroraCardStyle}">
            <StackPanel>
                <TextBlock Text="{resources:Loc Ui_Bootstrapper_Advanced}" Style="{StaticResource AuroraPageTitleStyle}" FontSize="15" Margin="0,0,0,8" />

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_MicroProfiler}" Description="{resources:Loc Ui_Gbs_EnableRobloxMicroprofilerServer}">
                    <ui:ToggleSwitch IsChecked="{Binding MicroProfilerWebServerEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="{resources:Loc Ui_Gbs_OnScreenProfiler}" Description="{resources:Loc Ui_Gbs_ShowFPSAndPerformanceOverlay}">
                    <ui:ToggleSwitch IsChecked="{Binding OnScreenProfilerEnabled, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:UiPage>
