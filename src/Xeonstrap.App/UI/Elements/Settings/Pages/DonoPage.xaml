<ui:UiPage xmlns:resources="clr-namespace:Xeonstrap.Resources"
           x:Class="Xeonstrap.UI.Elements.Settings.Pages.DonoPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:util="clr-namespace:Xeonstrap.Utility"
           xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
           xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls"
           Title="{resources:Loc Ui_Misc3_Donations}"
           Scrollable="True">

    <StackPanel Margin="{StaticResource AuroraPagePadding}">

        <TextBlock Text="{resources:Loc Ui_Misc3_Donations}"
                   Style="{StaticResource AuroraDisplayStyle}"
                   FontSize="24" />
        <TextBlock Margin="0,6,0,16"
                   Style="{StaticResource AuroraPageSubtitleStyle}"
                   Text="Every donation is optional. It goes straight to the group so it can be handed out through giveaways." />

        <Border Style="{StaticResource AuroraCardStyle}" Padding="14" Margin="0,0,0,16">
            <controls:Expander HeaderIcon="Gift24"
                               HeaderText="{resources:Loc Ui_Misc3_DonationInfo}"
                               IsExpanded="False">
                <StackPanel Margin="8">
                    <controls:MarkdownTextBlock MarkdownText="**Why Donate?**" Margin="0,0,0,6" />
                    <controls:MarkdownTextBlock MarkdownText="My projects are not about money, so I will never force you to pay. I have never received money from any of my projects!" Margin="0,0,0,6" />
                    <controls:MarkdownTextBlock MarkdownText="This page exists so you can support me through Xeonstrap giveaways in the Discord server or in general." Margin="0,0,0,6" />
                    <controls:MarkdownTextBlock MarkdownText="All donations are voluntary and highly appreciated ❤️" />
                </StackPanel>
            </controls:Expander>
        </Border>

        <TextBlock Text="Pick an amount" Style="{StaticResource AuroraSectionTitleStyle}" />

        <UniformGrid Columns="4">
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="0,0,6,6" CommandParameter="https://www.roblox.com/game-pass/1640060086" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate25R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,0,6,6" CommandParameter="https://www.roblox.com/game-pass/1634970203" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate50R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,0,6,6" CommandParameter="https://www.roblox.com/game-pass/1640713700" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate80R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,0,0,6" CommandParameter="https://www.roblox.com/game-pass/1635786271" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate300R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="0,6,6,0" CommandParameter="https://www.roblox.com/game-pass/1640123943" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate500R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,6,6,0" CommandParameter="https://www.roblox.com/game-pass/1635148417" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate1000R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,6,6,0" CommandParameter="https://www.roblox.com/game-pass/1635666786" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate1500R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AuroraCardButtonStyle}" Margin="6,6,0,0" CommandParameter="https://www.roblox.com/game-pass/1640153823" Command="{Binding OpenUrlCommand}">
                <StackPanel HorizontalAlignment="Center">
                    <Image Height="44" Stretch="Uniform" util:DynamicRenderSystem.LazyImageSource="https://www.pngall.com/wp-content/uploads/17/Roblox-Cash-Icon-Illustration-PNG.png" />
                    <TextBlock Text="{resources:Loc Ui_Misc3_Donate2000R}" HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource AuroraBodyStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <controls:MarkdownTextBlock MarkdownText="All donations go to the group so they can be handed out faster and smoother!" TextAlignment="Center" Margin="0,14,0,0" />
        <TextBlock TextAlignment="Center" Margin="0,8,0,0" FontSize="12">
            <Hyperlink CommandParameter="https://www.roblox.com/groups/36100411" Command="{Binding OpenUrlCommand}">Join our Roblox Group!</Hyperlink>
        </TextBlock>
    </StackPanel>
</ui:UiPage>
