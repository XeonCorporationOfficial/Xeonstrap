<ui:UiPage x:Class="Xeonstrap.UI.Elements.About.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Xeonstrap.UI.Elements.Controls" xmlns:models="clr-namespace:Xeonstrap.UI.ViewModels" xmlns:resources="clr-namespace:Xeonstrap.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Xeonstrap.Utility" Title="AboutPage" Scrollable="True" KeyDown="UiPage_KeyDown">
  <ui:UiPage.Resources>
    <Storyboard x:Key="EggStoryboard">
      <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" />
      <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:3" />
    </Storyboard>
    <Style x:Key="AboutSectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,26,0,8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="AboutSectionSubtitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <BitmapImage x:Key="ErikImage" UriSource="pack://application:,,,/Resources/Erik.png" DecodePixelHeight="176" CacheOption="OnLoad" CreateOptions="IgnoreColorProfile" />
    <Style x:Key="ErikButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="Transparent">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.88" />
        </Trigger>
      </Style.Triggers>
    </Style>    <Style x:Key="ContributorAvatar" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="Clip">
        <Setter.Value>
          <RectangleGeometry RadiusX="22" RadiusY="22" Rect="0,0,44,44" />
        </Setter.Value>
      </Setter>
    </Style>
  </ui:UiPage.Resources>
  <StackPanel Margin="{StaticResource AuroraPagePadding}">
    <ui:Card Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center">
          <Image x:Name="Image1" Source="pack://application:,,,/Xeonstrap.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <Image x:Name="Image2" Source="pack://application:,,,/Resources/BootstrapperStyles/ByfronDialog/Matt.png" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{resources:Loc Enums_Theme_Xeonstrap}" />
            <Border Margin="10,2,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
              <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version, Mode=OneTime}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc2_ASimpleYetAdvancedBloxstrapFork}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Margin="24,0,6,0" VerticalAlignment="Bottom" Style="{StaticResource ErikButton}" ToolTip="{resources:Loc Ui_Misc2_ThankYouErik}" Click="ErikButton_Click">
          <Image Height="74" Stretch="Uniform" Source="{StaticResource ErikImage}" RenderOptions.BitmapScalingMode="HighQuality" />
        </Button>
      </Grid>
    </ui:Card>
    <UniformGrid Margin="-4,8,-4,0" Columns="2">
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{resources:Loc Menu_About_Website}" Icon="Globe24" NavigateUri="https://xeonstrapp.pages.dev/" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{resources:Loc Menu_About_GithubRepository}" Icon="Code24" NavigateUri="https://github.com/XeonCorporationOfficial/Xeonstrap" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{resources:Loc Menu_About_HelpInformation}" Icon="BookQuestionMark24" NavigateUri="https://github.com/XeonCorporationOfficial/Xeonstrap#readme" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{resources:Loc Menu_About_ReportIssue}" Icon="BookExclamationMark24" NavigateUri="https://github.com/XeonCorporationOfficial/Xeonstrap/issues" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{resources:Loc Menu_About_DiscordServer}" Icon="Chat48" NavigateUri="https://discord.gg/wVFyshHUHh" />
    </UniformGrid>
    <TextBlock Style="{StaticResource AboutSectionTitle}" Text="{resources:Loc Ui_Misc2_MainContributors}" />
    <TextBlock Style="{StaticResource AboutSectionSubtitle}" Text="{resources:Loc Ui_Misc2_ThePeopleWhoMadeXeonstrapPossible}" />
    <UniformGrid Margin="-4,6,-4,0" Columns="1">
      <UniformGrid.Resources>
        <Style TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
      </UniformGrid.Resources>
      <ui:Card Margin="4" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource ContributorAvatar}">
            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="https://avatars.githubusercontent.com/u/165458529" />
          </Border>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="nguyenlegiabao13" />
        </Grid>
      </ui:Card>
    </UniformGrid>
    <TextBlock Style="{StaticResource AboutSectionTitle}" Text="{resources:Loc Menu_About_Contributors}" />
    <TextBlock Style="{StaticResource AboutSectionSubtitle}" Text="{resources:Loc Menu_About_Contributors_Description}" />
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:Expander Grid.Column="0" Margin="0,0,4,0" HeaderIcon="Code24" HeaderText="{resources:Loc Menu_About_Contributors_Code}" IsExpanded="False" ui:ExpanderMotion.UseLinuxAnimationClock="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[nguyenlegiabao13](https://github.com/nguyenlegiabao13)" />
        </StackPanel>
      </controls:Expander>
      <controls:Expander Grid.Column="1" Margin="4,0,4,0" HeaderIcon="AppsAddIn28" HeaderText="{resources:Loc Menu_About_Contributors_FeatureIdeas}" IsExpanded="False" ui:ExpanderMotion.UseLinuxAnimationClock="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[nguyenlegiabao13](https://github.com/nguyenlegiabao13)" />
        </StackPanel>
      </controls:Expander>
      <controls:Expander Grid.Column="2" Margin="4,0,0,0" HeaderIcon="Heart16" HeaderText="{resources:Loc Menu_About_Contributors_SpecialThanks}" IsExpanded="False" ui:ExpanderMotion.UseLinuxAnimationClock="False">
        <StackPanel>
          <controls:MarkdownTextBlock MarkdownText="[Fishstrap](https://github.com/returnrqt/)" />
          <controls:MarkdownTextBlock MarkdownText="[Bloxstrap](https://github.com/MaximumADHD)" />
          <controls:MarkdownTextBlock MarkdownText="[Froststrap](https://github.com/RealMeddsam/Froststrap)" />
          <controls:MarkdownTextBlock MarkdownText="[Fleasion](https://github.com/fleasion/Fleasion)" />
          <controls:MarkdownTextBlock MarkdownText="[MaximumADHD](https://github.com/BloxstrapLabs)" />
          <controls:MarkdownTextBlock MarkdownText="[Multako](https://www.roblox.com/users/2485612194/profile)" />
          <controls:MarkdownTextBlock MarkdownText="[axstin](https://github.com/axstin)" />
          <controls:MarkdownTextBlock MarkdownText="[Mantaraix](https://github.com/Mantaraix)" />
          <controls:MarkdownTextBlock MarkdownText="[apprehensions](https://github.com/apprehensions)" />
          <controls:MarkdownTextBlock MarkdownText="[NetSoftworks](https://github.com/netsoftwork)" />
          <controls:MarkdownTextBlock MarkdownText="[Naveandice](https://github.com/Naveandice)" />
          <controls:MarkdownTextBlock MarkdownText="[Skylan](https://github.com/Skylan031)" />
          <controls:MarkdownTextBlock MarkdownText="[Xaurchark](https://github.com/nicolasfp1)" />
          <controls:MarkdownTextBlock MarkdownText="[c_llie](https://discord.com/users/1053052072779583488)" />
          <controls:MarkdownTextBlock MarkdownText="[axellse](https://github.com/axellse)" />
          <controls:MarkdownTextBlock MarkdownText="[BlueOutside](https://github.com/BlueOutside)" />
        </StackPanel>
      </controls:Expander>
    </Grid>
    <StackPanel Visibility="{Binding BuildInformationVisibility, Mode=OneTime}">
      <TextBlock Style="{StaticResource AboutSectionTitle}" Text="{resources:Loc Ui_Misc2_BuildInformation}" />
      <ui:Card Margin="0,10,0,0" Padding="16,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Pages_Updated}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding BuildTimestamp, Mode=OneTime}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="{resources:Loc Common_Version}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Misc2_CommitHash}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
            <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding BuildCommitHashUrl, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <TextBlock Text="{Binding CommitHash, Mode=OneTime}" />
            </Hyperlink>
          </TextBlock>
        </Grid>
      </ui:Card>
    </StackPanel>
    <TextBlock Style="{StaticResource AboutSectionTitle}" Text="{resources:Loc Ui_Misc2_ThirdPartyNotices}" />
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{resources:Loc Ui_Misc2_ThisSoftwareContainsSourceCodeProvided}" TextWrapping="Wrap" />
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Mods_OldRobloxTopbarUi}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Ui_Misc2_TheClassicTopbarOptionRebuildsTwo}" />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/711267" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="{resources:Loc Ui_Misc2_20142015TopbarAndMenuBy}" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/620117" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="NoGuiRBX, Hide TopBar! by Einshine" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="{resources:Loc Ui_Misc2_CommunityMods}" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{resources:Loc Ui_Misc2_CommunityModsListsRobloxSubmissionsFrom}" />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="gamebanana.com/games/2879" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/klikos-modloader/marketplace" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="{resources:Loc Ui_Misc2_GithubComKlikosModloaderMarketplace}" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
  </StackPanel>
</ui:UiPage>
