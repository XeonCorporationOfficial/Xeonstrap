<Project>

	<Target Name="InvalidateStaleVersionMetadata" BeforeTargets="CoreGenerateAssemblyInfo" Condition="'$(GenerateAssemblyInfo)' == 'true' And Exists('$(GeneratedAssemblyInfoFile)')">
		<PropertyGroup>
			<_XeonstrapVersionMetadataStale>!$([System.IO.File]::ReadAllText('$(GeneratedAssemblyInfoFile)').Contains('AssemblyFileVersionAttribute(&quot;$(FileVersion)&quot;)'))</_XeonstrapVersionMetadataStale>
		</PropertyGroup>
		<Delete Files="$(GeneratedAssemblyInfoFile);@(IntermediateAssembly)" Condition="$(_XeonstrapVersionMetadataStale)" />
		<Delete Files="$(AppHostIntermediatePath);$(TargetDir)$(TargetName)$(_NativeExecutableExtension)" Condition="$(_XeonstrapVersionMetadataStale) And '$(UseAppHost)' == 'true'" />
	</Target>

	<PropertyGroup Condition="'$(MSBuildRuntimeType)' == 'Full'">
		<AlwaysCompileMarkupFilesInSeparateDomain>true</AlwaysCompileMarkupFilesInSeparateDomain>
	</PropertyGroup>

	<ItemGroup Condition="'$(EnableDefaultItems)' != 'false'">
		<Compile Remove="obj/**/*AssemblyInfo.cs" />
		<Compile Remove="obj/**/*AssemblyAttributes.cs" />
		<Compile Remove="obj-*/**/*AssemblyInfo.cs" />
		<Compile Remove="obj-*/**/*AssemblyAttributes.cs" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(XeonstrapLinuxPackagingRoot)' != ''">
		<ProGpuWpfEnableWin32CompatShim>false</ProGpuWpfEnableWin32CompatShim>
	</PropertyGroup>

	<Target Name="BuildLinuxWin32Compatibility" BeforeTargets="CoreCompile" Condition="$(RuntimeIdentifier.StartsWith('linux')) And $([MSBuild]::IsOSPlatform('Linux')) And '$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And Exists('$(_ProGpuWpfWin32CompatSource)')">
		<PropertyGroup>
			<_XeonstrapWin32CompatDirectory>$(BaseIntermediateOutputPath)win32compat/$(RuntimeIdentifier)/</_XeonstrapWin32CompatDirectory>
			<_XeonstrapWin32CompatLibrary>$(_XeonstrapWin32CompatDirectory)libwin32compat.so</_XeonstrapWin32CompatLibrary>
		</PropertyGroup>
		<Exec Command="bash &quot;$(MSBuildThisFileDirectory)build/Packaging/Linux/build-native-compat.sh&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(_XeonstrapWin32CompatLibrary)&quot; &quot;$(_ProGpuWpfWin32CompatSource)&quot;" />
		<ItemGroup>
			<_XeonstrapWin32CompatAlias Include="kernel32.dll.so;libkernel32.dll.so;user32.dll.so;libuser32.dll.so;gdi32.dll.so;libgdi32.dll.so;dwmapi.dll.so;libdwmapi.dll.so;uxtheme.dll.so;libuxtheme.dll.so;shell32.dll.so;libshell32.dll.so;gdiplus.dll.so;libgdiplus.dll.so;comdlg32.dll.so;libcomdlg32.dll.so" />
		</ItemGroup>
		<Copy SourceFiles="@(_XeonstrapWin32CompatAlias->'$(_XeonstrapWin32CompatLibrary)')" DestinationFiles="@(_XeonstrapWin32CompatAlias->'$(TargetDir)%(Identity)')" SkipUnchangedFiles="true" />
	</Target>


	<ItemGroup Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(MSBuildProjectName)' != 'Xeonstrap' And !$(RuntimeIdentifier.StartsWith('win'))">
		<Content Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Link="licenses/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Include="$(MSBuildThisFileDirectory)legal/sources/*.tar.gz" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Xeonstrap.Cross'">
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" LogicalName="Xeonstrap.Licenses.Notices" />
	</ItemGroup>

	<ItemGroup Condition="'$(MSBuildProjectName)' == 'Xeonstrap'">
		<EmbeddedResource Include="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.gz" LogicalName="Xeonstrap.Licenses.Notices.gz" />
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)legal/sources/*.tar.gz" LogicalName="Xeonstrap.Licenses.%(Filename)%(Extension)" />
	</ItemGroup>

	<UsingTask TaskName="CompressXeonstrapLicenseNotices" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Source ParameterType="System.String" Required="true" />
			<Destination ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System.IO" />
			<Using Namespace="System.IO.Compression" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				Directory.CreateDirectory(Path.GetDirectoryName(Destination));
				using (FileStream input = File.OpenRead(Source))
				using (FileStream output = File.Create(Destination))
				using (GZipStream compressed = new GZipStream(output, CompressionLevel.Optimal))
					input.CopyTo(compressed);
			]]></Code>
		</Task>
	</UsingTask>

	<Target Name="BuildCompressedLicenseNotices" BeforeTargets="AssignTargetPaths" Condition="'$(MSBuildProjectName)' == 'Xeonstrap'" Inputs="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt;$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.gz">
		<CompressXeonstrapLicenseNotices Source="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Destination="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.gz" />
		<ItemGroup>
			<FileWrites Include="$(IntermediateOutputPath)license-notices/THIRD-PARTY-NOTICES.txt.gz" />
		</ItemGroup>
	</Target>

	<Target Name="RemoveWindowsLicenseSidecars" BeforeTargets="CopyFilesToOutputDirectory;Publish" Condition="'$(MSBuildProjectName)' == 'Xeonstrap'">
		<RemoveDir Directories="$(OutDir)licenses" Condition="'$(OutDir)' != ''" />
		<RemoveDir Directories="$(PublishDir)licenses" Condition="'$(PublishDir)' != ''" />
	</Target>

</Project>
