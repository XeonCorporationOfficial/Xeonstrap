[Desktop Entry]
Type=Application
Name=Xeonstrap
GenericName=Roblox Bootstrapper
Comment=Customize and launch Roblox through Sober on Linux
Exec=xeonstrap %u
TryExec=xeonstrap
Icon=io.github.XeonCorporationOfficial.Xeonstrap
Terminal=false
Categories=Game;
Keywords=roblox;xeonstrap;bootstrapper;sober;
StartupNotify=true
StartupWMClass=xeonstrap
X-GNOME-WMClass=xeonstrap
MimeType=x-scheme-handler/roblox;x-scheme-handler/roblox-player;x-scheme-handler/roblox-studio;x-scheme-handler/roblox-studio-auth;x-scheme-handler/xeonstrap;
Actions=LaunchRoblox;LaunchRobloxStudio;Settings;

[Desktop Action LaunchRoblox]
Name=Launch Roblox
Exec=xeonstrap -player

[Desktop Action LaunchRobloxStudio]
Name=Launch Roblox Studio
Exec=xeonstrap -studio

[Desktop Action Settings]
Name=Xeonstrap Settings
Exec=xeonstrap -settings
